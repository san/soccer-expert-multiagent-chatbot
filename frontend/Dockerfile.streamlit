#Dockerfile.streamlit
# Dockerfile for Streamlit UI Deployment
# Builds and runs the Streamlit customer chatbot UI on Cloud Run

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Add Streamlit and dependencies to requirements
RUN echo "streamlit>=1.28.0" >> requirements.txt && \
    echo "requests>=2.31.0" >> requirements.txt && \
    echo "pydantic>=2.5.0" >> requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (only Streamlit UI, not FastAPI)
COPY streamlit_ui.py .

# Create directories for service account and streamlit config
RUN mkdir -p /app/credentials ~/.streamlit

# Create streamlit config file for Cloud Run
RUN echo '[server]\n' > ~/.streamlit/config.toml && \
    echo 'headless = true\n' >> ~/.streamlit/config.toml && \
    echo 'port = 8501\n' >> ~/.streamlit/config.toml && \
    echo 'enableXsrfProtection = false\n' >> ~/.streamlit/config.toml && \
    echo '[browser]\n' >> ~/.streamlit/config.toml && \
    echo 'gatherUsageStats = false\n' >> ~/.streamlit/config.toml && \
    echo '[client]\n' >> ~/.streamlit/config.toml && \
    echo 'showErrorDetails = true\n' >> ~/.streamlit/config.toml

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_SERVER_PORT=8080
ENV STREAMLIT_CLIENT_TOOLBAR_MODE=minimal

# Expose port for Cloud Run
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/_stcore/health || exit 1

# Run Streamlit app
CMD ["streamlit", "run", "streamlit_ui.py", "--server.port=8080", "--server.address=0.0.0.0"]
